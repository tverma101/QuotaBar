{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuotaBar",
  "mainBinaryName": "quotabar",
  "version": "0.1.0",
  "identifier": "com.tverma101.quotabar",
  "build": {
    "beforeDevCommand": "node scripts/tauri-before-dev.cjs",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run bundle:plugins && bun run build && node scripts/prepare-cli-sidecar.cjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QuotaBar",
        "width": 320,
        "height": 800,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com https://open.er-api.com; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; object-src 'none'; frame-src 'none'; base-uri 'none'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "QuotaBar",
    "homepage": "https://github.com/tverma101/QuotaBar",
    "shortDescription": "Track AI coding subscriptions from the system tray.",
    "longDescription": "QuotaBar tracks AI coding subscription limits, reset times, and usage from the system tray.",
    "copyright": "QuotaBar fork contributors; original OpenUsage \u00a9 Robin Ebers and contributors",
    "license": "MIT",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1 | libappindicator3-1",
          "libgtk-3-0",
          "xdg-desktop-portal",
          "xdg-desktop-portal-gtk | xdg-desktop-portal-gnome | xdg-desktop-portal-cosmic"
        ]
      }
    },
    "macOS": {
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/bundled_plugins/**/*",
      "resources/WINDOWS-PORTABLE.txt",
      "icons/tray-icon.png"
    ],
    "externalBin": [
      "binaries/quotabar-cli"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "startMenuFolder": "QuotaBar",
        "installMode": "currentUser"
      }
    }
  }
}
