{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "QuotaBar",
    "version": "0.7.0",
    "identifier": "com.tverma101.quotabar.desktop",
    "build": {
        "frontendDist": "../ui"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "label": "main",
                "title": "QuotaBar",
                "width": 440,
                "height": 660,
                "minWidth": 340,
                "minHeight": 420,
                "resizable": true,
                "visible": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
        }
    },
    "bundle": {
        "active": true,
        "targets": [
            "deb",
            "nsis"
        ],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.ico"
        ]
    }
}
